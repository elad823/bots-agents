# ==============================================================================
# Autonomous Multi-Agent System (MAS) - Production Environment Configuration
# ==============================================================================
ENVIRONMENT=production
LOG_LEVEL=WARNING

# Google AI Studio / Gemini Configuration
# NOTE: Set this secret in Google Cloud Secret Manager or GitHub Production Secrets
GEMINI_API_KEY=AIzaSy_production_secret_key_placeholder
GEMINI_MODEL_DEFAULT=gemini-1.5-flash

# Centralized Sliding-Window Rate Limiter (Gemini 15 RPM Free Tier Compliance)
MAX_RPM_LIMIT=14
RATE_LIMIT_WINDOW_SECONDS=60

# FastAPI Backend & Networking
PORT=8080
BACKEND_API_URL=https://mas-backend-prod-uc.a.run.app
CORS_ORIGINS=https://mas.streamlit.app,https://mas-frontend-prod-uc.a.run.app

# Database & Storage (Production Persistent Cloud Storage / Mounted Volume)
DATABASE_PATH=/app/data/mas_database.db
