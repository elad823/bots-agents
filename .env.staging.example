# ==============================================================================
# Autonomous Multi-Agent System (MAS) - Staging Environment Configuration
# ==============================================================================
ENVIRONMENT=staging
LOG_LEVEL=INFO

# Google AI Studio / Gemini Configuration
# NOTE: Set this secret in GitHub Actions Secrets or Cloud Run Environment Secrets
GEMINI_API_KEY=AIzaSy_staging_secret_key_placeholder
GEMINI_MODEL_DEFAULT=gemini-1.5-flash

# Centralized Sliding-Window Rate Limiter (Gemini 15 RPM Free Tier Compliance)
MAX_RPM_LIMIT=14
RATE_LIMIT_WINDOW_SECONDS=60

# FastAPI Backend & Networking
PORT=8080
BACKEND_API_URL=https://mas-backend-staging-uc.a.run.app
CORS_ORIGINS=https://mas-staging.streamlit.app,https://mas-frontend-staging-uc.a.run.app

# Database & Storage (Staging Persistent Storage)
DATABASE_PATH=/app/data/mas_database.db
